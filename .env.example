# Copy to .env and fill in. Never commit the real .env file.

# Model providers
ANTHROPIC_API_KEY=

# GitHub integration (skills: github.pr_list, github.pr_comment, ...)
GITHUB_TOKEN=

# Local database (per-project, defaults to .devfoundry/state.db if unset)
DEVFOUNDRY_DB_PATH=

# API server
DEVFOUNDRY_API_HOST=127.0.0.1
DEVFOUNDRY_API_PORT=8420
